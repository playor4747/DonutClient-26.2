{
  "schemaVersion": 1,
  "id": "donutclient",
  "version": "${version}",
  "name": "DonutClient",
  "description": "Client-side utility mod with a toggle menu, storage ESP, block search and freecam.",
  "authors": ["OpenAI"],
  "environment": "client",
  "entrypoints": {
    "client": ["dev.donut.client.DonutClient"]
  },
  "mixins": [
    {
      "config": "donutclient.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": ">=0.158.0+26.2"
  }
}
